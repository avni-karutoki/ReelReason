# App Configuration
APP_NAME=ReelReason API
# development | demo | production (production silences debug logs, drops CORS wildcard)
ENVIRONMENT=development
DEBUG=false
# Comma-separated list of allowed browser origins for CORS.
# For production, set this to your deployed frontend URL(s):
# ALLOWED_ORIGINS=https://reelreason.vercel.app,https://reelreason.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
PORT=8000
HOST=0.0.0.0

# Supabase Infrastructure
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your_super_secret_supabase_jwt_key_here

# Supabase Storage Buckets
SUPABASE_VIDEO_BUCKET=reelreason-videos
SUPABASE_AUDIO_BUCKET=reelreason-audio
SUPABASE_RENDERED_BUCKET=reelreason-rendered
SUPABASE_THUMBNAIL_BUCKET=reelreason-thumbnails

# AI Providers (options: mock, gemini, openai)
AI_PROVIDER=gemini
OPENAI_API_KEY=sk-proj-...
GEMINI_API_KEY=AIzaSy...

# Transcription (options: mock, gemini, openai, assemblyai)
# gemini reuses GEMINI_API_KEY above — one key covers analysis AND transcription.
TRANSCRIPTION_PROVIDER=gemini
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite
OPENAI_WHISPER_MODEL=whisper-1
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Remotion Video Renderer Service
RENDERER_BASE_URL=http://localhost:3000
RENDERER_API_KEY=reelreason_renderer_secret_token

# Processing Thresholds & Guardrails
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=15
MIN_CLIP_DURATION_SECONDS=20
MAX_CLIP_DURATION_SECONDS=90
TARGET_IDEAL_MIN_DURATION=30
TARGET_IDEAL_MAX_DURATION=60
