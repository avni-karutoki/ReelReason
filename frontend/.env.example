# ---------------------------------------------------------------------------
# ReelReason Frontend Environment
# ---------------------------------------------------------------------------

# VITE_API_URL: Base URL of the ReelReason FastAPI backend.
# Local:     http://localhost:8000
# Deployed:  Set this in Vercel to the public URL of the deployed FastAPI service.
# Without this setting, the app uses its local demo mode.
VITE_API_URL="http://localhost:8000"

# ---------------------------------------------------------------------------
# Supabase Auth (optional — enables real accounts)
# Get both values from your Supabase project dashboard → Settings → API.
# When these are set, login/signup use real Supabase Auth (email + password)
# and every request to the backend carries the session JWT.
# When omitted, the studio runs in guest/demo mode.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL="https://your-project.supabase.co"
# VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
